# ===== Настройки бота (скопируй в .env и заполни) =====

# Токен бота от @BotFather в Telegram
BOT_TOKEN=

# Файл OAuth-клиента Google (тип «Приложение для ПК» / Desktop app)
GOOGLE_CLIENT_SECRET=client_secret.json

# Часовой пояс для расписания
TIMEZONE=Europe/Chisinau

# Локальный порт веб-сервера (менять, только если 8080 занят)
PORT=8080

# --- необязательно ---
# Твой Telegram ID. Если пусто — владельцем станет первый, кто напишет боту /start.
# OWNER_ID=
# Свой постоянный HTTPS-адрес. Если пусто — бесплатный адрес Cloudflare при каждом запуске.
# PUBLIC_URL=
