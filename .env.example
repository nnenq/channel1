# ===== Настройки бота (скопируй в .env и заполни) =====

# Токен бота от @BotFather в Telegram
BOT_TOKEN=

# Файл OAuth-клиента Google (тип «Приложение для ПК» / Desktop app)
GOOGLE_CLIENT_SECRET=client_secret.json
# Необязательно: клиент типа «TVs and Limited Input devices» — привязка канала по коду
# с любого устройства (нужно, чтобы друзья могли привязать свои каналы)
GOOGLE_DEVICE_CLIENT_SECRET=client_secret_tv.json

# Часовой пояс для расписания
TIMEZONE=Europe/Chisinau

# Локальный порт веб-сервера (менять, только если 8080 занят)
PORT=8080

# --- необязательно ---
# Твой Telegram ID. Если пусто — владельцем станет первый, кто напишет боту /start.
# OWNER_ID=
# Свой постоянный HTTPS-адрес. Если пусто — бесплатный адрес Cloudflare при каждом запуске.
# PUBLIC_URL=

# --- умная обрезка ---
# Максимальный размер загружаемого видео (МБ) и длительность (минуты)
# CUT_MAX_MB=1024
# CUT_MAX_MINUTES=30
# Сколько часов живёт ссылка на скачивание результата
# CUT_LINK_TTL_H=24
# Модель распознавания речи faster-whisper: tiny / base / small / medium
# WHISPER_MODEL=small

# --- AI-режим умной обрезки (необязательно, платно) ---
# Ключ Claude API с console.anthropic.com (без него кнопки AI не будет)
# ANTHROPIC_API_KEY=
# Модель (цены — в pricing.yaml)
# CUT_AI_MODEL=claude-opus-5
# Разрешить AI-режим всем пользователям бота (по умолчанию только владельцу — деньги его)
# CUT_AI_FOR_ALL=0
# Предупреждать, когда остаток на счёте Claude меньше ($)
# CLAUDE_LOW_BALANCE_USD=5
# Admin-ключ (sk-ant-admin01-...) — точные расходы организации раз в час (Usage & Cost API)
# ANTHROPIC_ADMIN_KEY=
